{
  "appId": "pl.edu.pwr.kn-nami.smu-gui",
  "productName": "GUI-SMU",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist-electron",
    "dist-react",
    "node_modules/**/*"
  ],
  "extraResources": [
    "dist-electron/preload.cjs"
  ],
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "mac": {
    "target": "dmg",
    "extraResources": [
      "node_modules/serialport/**/*",
      "node_modules/exceljs/**/*",
      "backend/python-mac/**/*"
    ],
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/exceljs/**/*"
    ]
  },
  "linux": {
    "target": "AppImage",
    "category": "Utility",
    "extraResources": [
      "node_modules/serialport/**/*",
      "node_modules/exceljs/**/*",
      "backend/python-linux/**/*"
    ],
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/exceljs/**/*"
    ]
  },
  "win": {
    "target": [ "portable", "msi" ],
    "icon": "public/icon.ico",
    "sign": false,
    "signDlls": false,
    "signAndEditExecutable": false,
    "verifyUpdateCodeSignature": false,
    "extraResources": [
      "node_modules/serialport/**/*",
      "node_modules/exceljs/**/*",
      "backend/python-win/**/*"
    ],
    "asarUnpack": [
      "node_modules/serialport/**/*",
      "node_modules/exceljs/**/*"
    ],
    "artifactName": "${productName}-setup-${version}.${ext}",
    "publisherName": "KN NaMi",
    "requestedExecutionLevel": "asInvoker"
  }
}